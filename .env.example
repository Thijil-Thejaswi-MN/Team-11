# Database Configuration (MySQL 8 - Component C13)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=insurance_db
DB_USER=root
DB_PASSWORD=root

# Security Keys (Required in production, defaults supplied in dev/test)
# JWT_SECRET=change-this-in-production-to-a-secure-256-bit-key
# ENCRYPTION_KEY=change-this-in-production-to-a-secure-256-bit-key-64-hex-or-base64
# (Supports 64-char hex, 44-char Base64, or 32-byte UTF-8; dev default: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef)

# Storage Directory (Component C12 File Store)
FILE_STORE_DIR=./storage/uploads
