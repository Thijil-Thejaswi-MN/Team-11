        {
          "name": "Actuator Health Check (Real Endpoint)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Application health status is UP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            },
            "description": "Real live actuator health check endpoint implemented in Spring Boot backend skeleton."
          },
          "response": []
        },
        {
          "name": "Register Customer (Contract INS-F-001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or expected contract validation\", function () {",
                  "    try {",
                  "        pm.expect(pm.response.code).to.be.oneOf([201, 400, 409]);",
                  "    } catch (e) {",
                  "        if (pm.response === undefined || pm.response.code === undefined) {",
                  "            pm.test.skip('Skipped: no response received (connection failure).');",
                  "        } else {",
                  "            throw e;",
                  "        }",
                  "    }",
                  "});",
                  "pm.test(\"Password is never exposed in response body\", function () {",
                  "    try {",
                  "        var text = pm.response.text();",
                  "        pm.expect(text).to.not.include(\"SyntheticPassword123!\");",
                  "    } catch (e) {",
                  "        if (pm.response === undefined || typeof pm.response.text !== 'function') {",
                  "            pm.test.skip('Skipped: no response body available.');",
                  "        } else {",
                  "            throw e;",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Verma\",\n  \"email\": \"asha.verma.test@example.invalid\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"SyntheticPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Contract example: POST /api/v1/auth/register for creating customer accounts."
          },
          "response": []
        },
