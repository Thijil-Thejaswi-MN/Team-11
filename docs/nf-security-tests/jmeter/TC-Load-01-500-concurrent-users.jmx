        <ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="10% dashboards" enabled="true">
          <intProp name="ThroughputController.style">1</intProp>
          <boolProp name="ThroughputController.perThread">false</boolProp>
